# applied on top of allnoconfig: only what the P80h uses, grown stage by stage
CONFIG_LOCALVERSION="-p80h"
CONFIG_64BIT=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_EXT4_FS=y
CONFIG_BLOCK=y
CONFIG_SERIAL_8250=n
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MT8163_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_CONFIGFS_FS=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
CONFIG_MT8163_RAMLOG=y
CONFIG_CMDLINE="console=tty0 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=10 loglevel=5"
CONFIG_CMDLINE_FORCE=y
CONFIG_COMMON_CLK_MT8163=y
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_MFD_SYSCON=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MTK=y
CONFIG_PINCTRL_MT8163=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6323=y
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_MT8163_CPUXGPT=y
# CONFIG_MT8163_EMMCLOG is not set	# bring-up log: it owns MSDC0, enable it only with mmc0 disabled
CONFIG_MUSB_PIO_ONLY=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set
