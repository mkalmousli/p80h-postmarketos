# applied on top of allnoconfig: only what the P80h uses, grown stage by stage
CONFIG_LOCALVERSION="-p80h"
CONFIG_64BIT=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=y
CONFIG_MT8163_CPU_POWER=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_EXT4_FS=y
CONFIG_BLOCK=y
CONFIG_SERIAL_8250=n
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MT8163_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_CONFIGFS_FS=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
# CONFIG_MT8163_RAMLOG is not set
CONFIG_CMDLINE="console=tty0 fbcon=map:9 clk_ignore_unused pd_ignore_unused regulator_ignore_unused panic=10 quiet loglevel=0 vt.global_cursor_default=0"
CONFIG_CMDLINE_FORCE=y
CONFIG_COMMON_CLK_MT8163=y
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_MFD_SYSCON=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_MTK=y
CONFIG_PINCTRL_MT8163=y
CONFIG_RESET_CONTROLLER=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6323=y
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_MT8163_CPUXGPT=y
# CONFIG_MT8163_EMMCLOG is not set	# bring-up log: it owns MSDC0, enable it only with mmc0 disabled
CONFIG_MUSB_PIO_ONLY=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# CONFIG_IO_STRICT_DEVMEM is not set
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT6323=y
CONFIG_I2C_CHARDEV=y
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_BQ2415X=y
CONFIG_IIO=y
CONFIG_DA280=y
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL_HIMAX_HX8394=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=n
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_P80H_REBOOT_MODE=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_CONFIGFS_FS=y
# usable userspace: chronyd (seccomp), nftables (NetworkManager/firewall), zram swap, removable media, FUSE
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_FUSE_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_USER_NS=y
CONFIG_BINFMT_MISC=y
CONFIG_KEYBOARD_MT6779=y
CONFIG_PWM=y
CONFIG_PWM_MTK_DISP=y
CONFIG_BACKLIGHT_PWM=y
# desktop: swap (zram), SysV shm (MIT-SHM for Xorg/Firefox), IPv6, hrtimers for audio, HID for input devices
CONFIG_SWAP=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPV6=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
# battery gauge (MT6323 AUXADC), sound (MT8163 AFE + MT6323 codec via simple-audio-card)
CONFIG_BATTERY_MT6323=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_MT8163=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
# SoC thermal (auxadc_thermal, mt8163 data from stock mtk_ts_cpu, patch 0019)
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
# CONSYS bring-up: the conn_soc/wlan_gen2 stack is iterated as modules first (insmod over the daemon, no reflash)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y
CONFIG_UHID=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
# USB OTG host (ID on GPIO38, VBUS = FAN5405 boost, patch 0020): role switch, storage, common USB NICs
CONFIG_USB_CONN_GPIO=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
