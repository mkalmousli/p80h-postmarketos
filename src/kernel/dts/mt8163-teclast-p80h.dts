/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "mt8163.dtsi"

/ {
	model = "Teclast P80h";
	compatible = "teclast,p80h", "mediatek,mt8163";

	chosen {
		bootargs = "console=tty0 clk_ignore_unused pd_ignore_unused panic=10 initcall_debug ignore_loglevel";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* the panel is already lit by the bootloader (LK), keep scanning out its buffer */
		framebuffer@7ec00000 {
			compatible = "simple-framebuffer";
			reg = <0 0x7ec00000 0 0x3e8000>;
			width = <800>;
			height = <1280>;
			stride = <3200>;
			format = "a8r8g8b8";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x3e800000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		atf@43000000 { reg = <0 0x43000000 0 0x30000>; no-map; };
		ramlog@43f00000 { reg = <0 0x43f00000 0 0x10000>; no-map; };	/* persistent RAM console, see mt8163-ramlog.c */
	};
};

/* placeholder: no PMIC driver yet and the bootloader left the eMMC rail on. The core derives the host OCR mask
 * from this regulator and the card only advertises 2.7-3.1 V. */
&{/} {
	vmmc: regulator-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "vmmc";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
	};
};

&pio {
	/* pinmux cell = (pin << 8) | function, as in the vendor tree; pulls as the vendor board file sets them */
	mmc0_pins: mmc0 {
		pins-cmd-dat {
			pinmux = <0x8901>, <0x8801>, <0x8701>, <0x8601>, <0x8201>, <0x8101>, <0x8001>, <0x7f01>, <0x8401>;
			input-enable;
			bias-pull-up;
		};
		pins-clk {
			pinmux = <0x8501>;
			bias-pull-down;
		};
	};
};

&pio {
	i2c0_pins: i2c0 {
		pins {
			pinmux = <0x4b01>, <0x4c01>;
			bias-disable;
		};
	};
};

&pio {
	i2c1_pins: i2c1 {
		pins {
			pinmux = <0x3901>, <0x3a01>;	/* GPIO57/58 = SDA1/SCL1 */
			bias-disable;
		};
	};
	i2c2_pins: i2c2 {
		pins {
			pinmux = <0x4d01>, <0x4e01>;	/* GPIO77/78 = SDA2/SCL2 */
			bias-disable;
		};
	};
};

/* SY8827 buck at 0x60 (stock sym827_init); no node yet: it likely feeds VPROC, so nothing may touch it before it is understood */
&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * MIR3DA (stock mir3da_init, ITEMS accelerometer.i2c = 2). ITEMS orientation 7 = stock
	 * hwmsen map {-1,-1,-1}/{1,0,2}: x = -y_raw, y = -x_raw, z = -z_raw.
	 */
	accelerometer@26 {
		compatible = "miramems,da280";
		reg = <0x26>;
		mount-matrix = "0", "-1", "0",
			       "-1", "0", "0",
			       "0", "0", "-1";
	};
};

&mmc0 {
	vmmc-supply = <&vmmc>;
	bus-width = <8>;
	max-frequency = <50000000>;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-1 = <&mmc0_pins>;
	cap-mmc-highspeed;
	no-sd;
	no-sdio;
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <400000>;
	status = "okay";

	/* Silead GSLx68x; INT = GPIO35, RST = GPIO46, rail VGP2 (left on by the bootloader, no PMIC driver yet) */
	touchscreen@40 {
		compatible = "silead,gsl1680";
		reg = <0x40>;
		interrupt-parent = <&pio>;
		interrupts = <35 IRQ_TYPE_EDGE_FALLING>;
		power-gpios = <&pio 46 GPIO_ACTIVE_HIGH>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <1280>;
		firmware-name = "gsl1680-teclast-p80h.fw";
		vddio-supply = <&mt6323_vgp2_reg>;
		avdd-supply = <&mt6323_vgp2_reg>;
		silead,max-fingers = <5>;
	};

	/*
	 * FAN5405 (stock fan5405_init: i2c_register_board_info bus 0, addr 0x6a; the
	 * vendor DT's bq24296@6b node is stale). Same register map as bq24156, which
	 * bq2415x detects from PN=0 at 0x6a. Limits from the stock register dump
	 * ([fan5405] 00=d0 01=78 02=8e 03=41 04=84 05=03 06=70), Rsense 68 mOhm per datasheet.
	 */
	charger@6a {
		compatible = "ti,bq24156";
		reg = <0x6a>;
		ti,current-limit = <500>;
		ti,weak-battery-voltage = <3700>;
		ti,battery-regulation-voltage = <4200>;
		ti,charge-current = <550>;
		ti,termination-current = <250>;
		ti,resistor-sense = <68>;
	};
};

/* micro-SD slot; the card rail (VMCH) is switched by the PMIC, so until that driver exists a fixed 3.0 V stands in */
&pio {
	mmc1_pins: mmc1 {
		pins-cmd-dat {
			pinmux = <0x7b01>, <0x7c01>, <0x7d01>, <0x7e01>, <0x7901>;
			input-enable;
			bias-pull-up;
		};
		pins-clk {
			pinmux = <0x7a01>;
			bias-pull-down;
		};
		pins-insert {
			pinmux = <0x3100>;
			bias-pull-up;
		};
	};
};

&mmc1 {
	vmmc-supply = <&mt6323_vmch_reg>;
	vqmmc-supply = <&mt6323_vmc_reg>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	/* ITEMS sd.dete.pin = 28, sd.dete.enit.num = 6 (GPIO28 is EINT6); douglas used 49. Polarity not yet confirmed */
	cd-gpios = <&pio 28 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins>;
	pinctrl-1 = <&mmc1_pins>;
	no-mmc;
	no-sdio;
	status = "okay";
};
