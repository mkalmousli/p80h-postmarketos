--- a/drivers/gpu/drm/mediatek/mtk_dsi.c
+++ b/drivers/gpu/drm/mediatek/mtk_dsi.c
@@ -717,6 +717,22 @@
 		writel(FORCE_COMMIT | BYPASS_SHADOW,
 		       dsi->regs + dsi->driver_data->reg_shadow_dbg_off);
 
+	/*
+	 * A bootloader may hand over a running video-mode engine (MT8163 LK: DSI_START 1,
+	 * MODE_CTRL sync-pulse, INTSTA 0x80000712). The reset does not touch MODE_CTRL, so the
+	 * engine would come out of reset busy and the IRQ handler would spin on DSI_BUSY forever
+	 * acking the stale CMD_DONE. Stop it, go to command mode, wait until idle, drop the status.
+	 */
+	if (readl(dsi->regs + DSI_START) || readl(dsi->regs + DSI_MODE_CTRL)) {
+		u32 sta;
+
+		writel(0, dsi->regs + DSI_START);
+		mtk_dsi_set_cmd_mode(dsi);
+		if (readl_poll_timeout(dsi->regs + DSI_INTSTA, sta, !(sta & DSI_BUSY), 10, 100000))
+			dev_warn(dev, "bootloader DSI engine did not go idle\n");
+	}
+	writel(0, dsi->regs + DSI_INTSTA);
+
 	mtk_dsi_reset_engine(dsi);
 	mtk_dsi_phy_timconfig(dsi);
 
