+/* LK passes the efuse shadow as /chosen atag,devinfo: 2 header words, then get_devinfo_with_index() data (LE) */
+static u32 *mtk_thermal_devinfo_calibration(size_t *len)
+{
+	struct device_node *np = of_find_node_by_path("/chosen");
+	const __le32 *p;
+	int n = 0, i;
+	u32 *buf;
+
+	p = of_get_property(np, "atag,devinfo", &n);
+	of_node_put(np);
+	if (!p || n < 12 * 4)
+		return ERR_PTR(-ENOENT);
+	buf = kmalloc_array(3, sizeof(u32), GFP_KERNEL);
+	if (!buf)
+		return ERR_PTR(-ENOMEM);
+	for (i = 0; i < 3; i++)
+		buf[i] = le32_to_cpu(p[2 + 7 + i]);
+	*len = 3 * sizeof(u32);
+	return buf;
+}
