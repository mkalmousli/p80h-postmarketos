diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index 63c86c046..978a3a18d 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -80,6 +80,10 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 		if (glue->role == USB_ROLE_NONE)
 			phy_power_on(glue->phy);
 
+		/* the session samples ID: the PHY must present the host ID before it starts; no gadget D+ pullup */
+		phy_set_mode(glue->phy, glue->phy_mode);
+		musb_writeb(musb->mregs, MUSB_POWER,
+			    musb_readb(musb->mregs, MUSB_POWER) & ~MUSB_POWER_SOFTCONN);
 		devctl |= MUSB_DEVCTL_SESSION;
 		musb_writeb(musb->mregs, MUSB_DEVCTL, devctl);
 		MUSB_HST_MODE(musb);
@@ -94,6 +98,9 @@ static int mtk_otg_switch_set(struct mtk_glue *glue, enum usb_role role)
 			phy_power_on(glue->phy);
 
 		MUSB_DEV_MODE(musb);
+		if (musb->softconnect)	/* pullup requested by the gadget while we were the host */
+			musb_writeb(musb->mregs, MUSB_POWER,
+				    musb_readb(musb->mregs, MUSB_POWER) | MUSB_POWER_SOFTCONN);
 		break;
 	case USB_ROLE_NONE:
 		glue->phy_mode = PHY_MODE_USB_OTG;
diff --git a/drivers/usb/musb/musb_gadget.c b/drivers/usb/musb/musb_gadget.c
index da2b864fd..daf9059f3 100644
--- a/drivers/usb/musb/musb_gadget.c
+++ b/drivers/usb/musb/musb_gadget.c
@@ -1597,6 +1597,10 @@ static void musb_pullup(struct musb *musb, int is_on)
 {
 	u8 power;
 
+	/* a gadget bound while the port is the host must not pull D+ up (looks like a device to our own root port);
+	 * the OTG glue applies the pending pullup when it switches back to device */
+	if (is_on && musb->is_host)
+		return;
 	power = musb_readb(musb->mregs, MUSB_POWER);
 	if (is_on)
 		power |= MUSB_POWER_SOFTCONN;
@@ -1846,7 +1850,14 @@ static int musb_gadget_start(struct usb_gadget *g,
 
 	if (musb->xceiv)
 		otg_set_peripheral(musb->xceiv->otg, &musb->g);
-	else
+	if (is_host_active(musb)) {
+		/* OTG port currently the host (role switch): keep the role, only (re)enable the controller interrupts */
+		spin_unlock_irqrestore(&musb->lock, flags);
+		musb_start(musb);			/* interrupts on; it also drops the session ... */
+		phy_set_mode(musb->phy, PHY_MODE_USB_HOST);	/* ... which the PHY's A-device sequence restarts */
+		goto done;
+	}
+	if (!musb->xceiv)
 		phy_set_mode(musb->phy, PHY_MODE_USB_DEVICE);
 
 	musb_set_state(musb, OTG_STATE_B_IDLE);
@@ -1861,6 +1872,7 @@ static int musb_gadget_start(struct usb_gadget *g,
 	if (musb->xceiv && musb->xceiv->last_event == USB_EVENT_ID)
 		musb_platform_set_vbus(musb, 1);
 
+done:
 	pm_runtime_mark_last_busy(musb->controller);
 	pm_runtime_put_autosuspend(musb->controller);
 
