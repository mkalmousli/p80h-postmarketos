# bottom bar: apps menu + launchers | windows | tray (Wi-Fi, Bluetooth, volume) | battery | clock
panel_items = LTSBC
panel_size = 100% 60
panel_position = bottom center horizontal
panel_background_id = 1
rounded = 0
background_color = #1d2a38 100
border_width = 0
launcher_padding = 4 6 6
launcher_icon_size = 44
launcher_icon_theme = ePapirus
launcher_item_app = /usr/local/share/applications/menu.desktop
launcher_item_app = /usr/local/share/applications/browser.desktop
launcher_item_app = /usr/local/share/applications/terminal.desktop
launcher_item_app = /usr/local/share/applications/files.desktop
launcher_item_app = /usr/local/share/applications/keyboard.desktop
launcher_item_app = /usr/local/share/applications/sound-test.desktop
launcher_item_app = /usr/local/share/applications/bright-down.desktop
launcher_item_app = /usr/local/share/applications/bright-up.desktop
taskbar_mode = single_desktop
task_text = 0
task_icon = 1
task_maximum_size = 60 56
systray_padding = 4 4 6
systray_icon_size = 36
battery_low_status = 10
battery_low_cmd = notify-send "Battery low"
bat1_font = DejaVu Sans Bold 11
bat2_font = DejaVu Sans 9
battery_font_color = #ffffff 100
time1_format = %H:%M
time1_font = DejaVu Sans Bold 15
clock_font_color = #ffffff 100
clock_lclick_command = pavucontrol
