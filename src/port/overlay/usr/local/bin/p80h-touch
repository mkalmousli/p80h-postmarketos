#!/usr/bin/python3
"""Touchscreen -> mouse for X: grabs the Silead panel and drives a virtual absolute mouse (uinput "p80h-touch").
  tap = left click (two taps = double click)   drag = left drag         long press (0.6 s) = right click
  two-finger tap = right click                 two-finger drag = scroll  three-finger tap = on-screen keyboard
The kernel already maps the panel to the portrait frame (DT touchscreen-* props); p80h-rotate rotates this device.
"""
import fcntl
import glob
import os
import select
import struct
import subprocess
import time

EV_SYN, EV_KEY, EV_REL, EV_ABS = 0, 1, 2, 3
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
REL_WHEEL, REL_HWHEEL, ABS_X, ABS_Y = 8, 6, 0, 1
ABS_MT_SLOT, ABS_MT_X, ABS_MT_Y, ABS_MT_ID = 0x2F, 0x35, 0x36, 0x39
EV = "llHHi"
LONG, TAP2, DBL = 0.6, 0.35, 0.4  # seconds


def find_panel():
    for path in sorted(glob.glob("/sys/class/input/event*")):
        if "silead" in open(path + "/device/name").read():
            return "/dev/input/" + os.path.basename(path)
    raise SystemExit("no silead touchscreen")


def absinfo(fd, code):
    buf = fcntl.ioctl(fd, 0x80184540 + code, bytes(24))
    return struct.unpack("6i", buf)[2]  # maximum


src = os.open(find_panel(), os.O_RDONLY)
mx, my = absinfo(src, ABS_MT_X), absinfo(src, ABS_MT_Y)
fcntl.ioctl(src, 0x40044590, 1)  # EVIOCGRAB: X sees only the virtual mouse
ui = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
for bit, ioc in ((EV_KEY, 0x40045564), (EV_REL, 0x40045564), (EV_ABS, 0x40045564), (EV_SYN, 0x40045564)):
    fcntl.ioctl(ui, ioc, bit)
for key in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE):
    fcntl.ioctl(ui, 0x40045565, key)
for rel in (REL_WHEEL, REL_HWHEEL):
    fcntl.ioctl(ui, 0x40045566, rel)
for ab in (ABS_X, ABS_Y):
    fcntl.ioctl(ui, 0x40045567, ab)
absmax = [0] * 64
absmax[ABS_X], absmax[ABS_Y] = mx, my
os.write(ui, struct.pack("80sHHHHI64i64i64i64i", b"p80h-touch", 6, 0x1234, 0x5678, 1, 0, *absmax, *([0] * 192)))
fcntl.ioctl(ui, 0x5501)  # UI_DEV_CREATE


def emit(*events):
    os.write(ui, b"".join(struct.pack(EV, 0, 0, t, c, v) for t, c, v in events) + struct.pack(EV, 0, 0, 0, 0, 0))


def move(p):
    emit((EV_ABS, ABS_X, p[0]), (EV_ABS, ABS_Y, p[1]))


def click(btn):
    emit((EV_KEY, btn, 1))
    emit((EV_KEY, btn, 0))


slots, slot = {}, 0
fingers = 0  # most fingers in the current touch
start = t0 = 0.0
pressed = consumed = scrolled = False
last_tap = (0.0, (0, 0))
far = max(mx, my) // 40  # ~2 % of the panel: a tap that moved less than this is still a tap
while True:
    select.select([src], [], [], 0.05 if slots and not consumed else None)
    now = time.monotonic()
    if fingers == 1 and slots and not pressed and not consumed and now - t0 > LONG:
        click(BTN_RIGHT)  # long press
        consumed = True
    data = os.read(src, 24 * 64) if select.select([src], [], [], 0)[0] else b""
    for i in range(0, len(data) - 23, 24):
        _, _, typ, code, val = struct.unpack(EV, data[i:i + 24])
        if typ == EV_ABS and code == ABS_MT_SLOT:
            slot = val
        elif typ == EV_ABS and code == ABS_MT_ID:
            if val < 0:
                slots.pop(slot, None)
            else:
                slots[slot] = [0, 0]
        elif typ == EV_ABS and code in (ABS_MT_X, ABS_MT_Y) and slot in slots:
            slots[slot][code - ABS_MT_X] = val
        elif typ == EV_SYN and code == 0:
            n = len(slots)
            if n and fingers == 0:  # touch down
                fingers, t0, consumed, scrolled = 1, now, False, False
                p = list(slots.values())[0]
                if now - last_tap[0] < DBL and abs(p[0] - last_tap[1][0]) + abs(p[1] - last_tap[1][1]) < 3 * far:
                    p = list(last_tap[1])  # second tap of a double tap: same spot
                start = list(p)
                move(p)
            elif n > fingers:
                fingers = n
                if pressed:
                    emit((EV_KEY, BTN_LEFT, 0))
                    pressed = False
                start = [sum(q[k] for q in slots.values()) // n for k in (0, 1)]
            if n == 1 and fingers == 1 and not consumed:
                p = list(slots.values())[0]
                if not pressed and abs(p[0] - start[0]) + abs(p[1] - start[1]) > far:
                    move(start)
                    emit((EV_KEY, BTN_LEFT, 1))  # drag
                    pressed = True
                if pressed:
                    move(p)
            elif n >= 2 and fingers == 2:
                c = [sum(q[k] for q in slots.values()) // n for k in (0, 1)]
                steps = (c[1] - start[1]) // (2 * far)
                hsteps = (c[0] - start[0]) // (2 * far)
                if steps or hsteps:
                    emit((EV_REL, REL_WHEEL, steps), (EV_REL, REL_HWHEEL, -hsteps))
                    start, scrolled = c, True
            if n == 0 and fingers:  # all fingers up
                if pressed:
                    emit((EV_KEY, BTN_LEFT, 0))
                elif not consumed and not scrolled and now - t0 < TAP2 + LONG:
                    if fingers == 1:
                        click(BTN_LEFT)
                        last_tap = (now, tuple(start))
                    elif fingers == 2:
                        click(BTN_RIGHT)
                    elif fingers >= 3:
                        subprocess.Popen(["/usr/local/bin/p80h-keyboard"])
                fingers, pressed = 0, False
