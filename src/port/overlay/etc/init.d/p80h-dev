#!/sbin/openrc-run
# The vendor 3.10 kernel has no devtmpfs: build /dev with busybox mdev instead of udev.
description="device nodes via mdev, devpts"

depend() {
	before *
}

start() {
	mkdir -p /dev/pts /dev/shm
	mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
	echo /sbin/mdev > /proc/sys/kernel/hotplug
	mdev -s 2>/dev/null
	return 0
}
