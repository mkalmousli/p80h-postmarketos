--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -1224,6 +1224,9 @@
 	rsp = cmd->resp;
 
 	sdr_clr_bits(host->base + MSDC_INTEN, cmd_ints_mask);
+	dev_info(host->dev, "p80h: cmd%d ev=%x fl=%x r=%08x %08x %08x %08x ps=%08x\n", cmd->opcode, events, cmd->flags,
+		 readl(host->base + SDC_RESP0), readl(host->base + SDC_RESP1), readl(host->base + SDC_RESP2),
+		 readl(host->base + SDC_RESP3), readl(host->base + MSDC_PS));
 
 	if (cmd->flags & MMC_RSP_PRESENT) {
 		if (cmd->flags & MMC_RSP_136) {
@@ -1711,8 +1714,22 @@
 	return IRQ_HANDLED;
 }
 
+/* bring-up knobs (~0 = leave the driver default): applied at the end of msdc_init_hw() */
+static uint p80h_iocon = ~0, p80h_tune = ~0, p80h_patch1 = ~0, p80h_patch2 = ~0;
+module_param(p80h_iocon, uint, 0644);
+module_param(p80h_tune, uint, 0644);
+module_param(p80h_patch1, uint, 0644);
+module_param(p80h_patch2, uint, 0644);
+
 static void msdc_init_hw(struct msdc_host *host)
 {
+	{	/* bootloader state of the whole register block, before the driver touches it */
+		int o;
+
+		for (o = 0; o < 0x100; o += 16)
+			dev_info(host->dev, "p80h: lk %02x: %08x %08x %08x %08x\n", o, readl(host->base + o),
+				 readl(host->base + o + 4), readl(host->base + o + 8), readl(host->base + o + 12));
+	}
 	u32 val;
 	u32 tune_reg = host->dev_comp->pad_tune_reg;
 	struct mmc_host *mmc = mmc_from_priv(host);
@@ -1862,6 +1879,17 @@
 		host->def_tune_para.pad_tune = readl(host->base + tune_reg);
 		host->saved_tune_para.pad_tune = readl(host->base + tune_reg);
 	}
+	if (p80h_iocon != ~0)
+		writel(p80h_iocon, host->base + MSDC_IOCON);
+	if (p80h_tune != ~0)
+		writel(p80h_tune, host->base + MSDC_PAD_TUNE0);
+	if (p80h_patch1 != ~0)
+		writel(p80h_patch1, host->base + MSDC_PATCH_BIT1);
+	if (p80h_patch2 != ~0)
+		writel(p80h_patch2, host->base + MSDC_PATCH_BIT2);
+	dev_info(host->dev, "p80h: cfg=%08x iocon=%08x patch=%08x/%08x/%08x tune0=%08x\n", readl(host->base + MSDC_CFG),
+		 readl(host->base + MSDC_IOCON), readl(host->base + MSDC_PATCH_BIT), readl(host->base + MSDC_PATCH_BIT1),
+		 readl(host->base + MSDC_PATCH_BIT2), readl(host->base + MSDC_PAD_TUNE0));
 	dev_dbg(host->dev, "init hardware done!");
 }
 
